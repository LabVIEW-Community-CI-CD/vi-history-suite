{
  "schema": "vi-history-suite/windows-docker-desktop-proof-intake@v1",
  "status": "prepared-gitlab-authority",
  "packageVersion": "1.3.13",
  "publicIssue": "https://github.com/svelderrainruiz/vi-history-suite/issues/65",
  "marketplacePreReleaseVersion": "1.3.13",
  "objective": "collect admissible Windows Docker Desktop Windows-container fixture proof without treating existing Linux or Windows host proof as Docker Desktop proof",
  "fixture": {
    "repository": "https://github.com/ni/labview-icon-editor",
    "viPath": "resource/plugins/lv_icon.vi",
    "oldCommit": "ab94f6c4b375062492036c63a6dab7ea8824748a",
    "newCommit": "8741bb08026c104100720c0ef48621e4ab7762fd",
    "windowsDockerImage": "nationalinstruments/labview:2026q1-windows"
  },
  "command": "vihs validate-fixture --provider docker --labview-version 2026 --labview-bitness x64 --proof-out .\\vihs-fixture-proof --runtime-timeout-ms 300000",
  "environmentPrerequisites": {
    "platform": "win32",
    "windowsVersion": "Windows 10 or Windows 11",
    "dockerDesktop": "installed",
    "dockerContainerMode": "windows-containers",
    "dockerInfoCommand": "docker info --format \"{{.OSType}} {{.OperatingSystem}}\"",
    "requiredDockerOSType": "windows",
    "extensionVersion": "1.3.13",
    "disallowed": [
      "linux-docker-engine",
      "docker-desktop-linux-containers",
      "wsl-only",
      "platform-injection",
      "windows-host-provider-proof",
      "private-vi-fixture"
    ]
  },
  "admissibleSuccess": {
    "selectedVariant": {
      "platform": "win32",
      "provider": "docker",
      "labviewVersion": "2026",
      "labviewBitness": "x64"
    },
    "result": {
      "runtimeProvider": "windows-container",
      "runtimeEngine": "labview-cli",
      "runtimeExecutionState": "succeeded",
      "generatedReportExists": true
    },
    "requiredArtifacts": [
      "vihs-fixture-validation-proof.json",
      "vihs-fixture-validation-issue.md",
      "HARNESS-VHS-002 harness markdown or HTML",
      "docker version",
      "docker info OSType readback"
    ]
  },
  "admissibleNonSuccess": {
    "requiredFacts": [
      "runtimeErrorCode-or-runtimeBlockedReason",
      "docker version",
      "docker info OSType readback",
      "proof packet",
      "redacted logs or diagnostic references when present"
    ],
    "classifications": [
      "validation:failure",
      "feature:not-implemented",
      "blocked-prerequisite",
      "documentation"
    ]
  },
  "publicIntake": {
    "templatePath": "public-github-source/.github/ISSUE_TEMPLATE/windows-docker-desktop-validation.yml",
    "contactLinkName": "Windows Docker Desktop validation",
    "labels": [
      "community-validation",
      "marketplace-preview",
      "provider:docker",
      "windows-labview",
      "windows-docker-desktop",
      "version:1.3.13",
      "proof:reported",
      "needs-triage"
    ]
  },
  "proofBoundary": {
    "linuxDocker2026x64": "admitted",
    "linuxHostLabview2026x64": "admitted",
    "windowsHostLabview2026x64": "admitted",
    "windowsDockerDesktopWindowsContainers": "community-deferred-until-issue-65-packet-is-admitted",
    "marketplaceMutation": "not-required-for-this-intake-slice"
  },
  "triageLoop": [
    "confirm-public-issue-65",
    "confirm-docker-ostype-windows",
    "confirm-canonical-fixture",
    "classify-result",
    "apply-proof-reported",
    "apply-proof-reproduced-only-after-retained-proof",
    "keep-marketplace-unchanged-unless-later-release-slice-authorizes-publication"
  ]
}
