  "proofStatusLadder": [
    {
      "status": "community-reported",
      "meaning": "user submitted a report but completeness is not checked",
      "releaseControlEffect": "signal-only"
    },
    {
      "status": "intake-complete",
      "meaning": "required facts and commands are present and safe to retain",
      "releaseControlEffect": "eligible-for-triage-and-possible-reproduction"
    },
    {
      "status": "needs-more-evidence",
      "meaning": "required facts, commands, or reproduction steps are missing",
      "releaseControlEffect": "does-not-change-proof-state"
    },
    {
      "status": "maintainer-reproduction-pending",
      "meaning": "complete report exists but no admitted host has reproduced it",
      "releaseControlEffect": "remains-community-deferred"
    },
    {
      "status": "maintainer-reproduced",
      "meaning": "maintainer reproduced the path on an admitted Windows/LabVIEW setup",
      "releaseControlEffect": "eligible-for-authority-proof-retention"
    },
    {
      "status": "admitted-proof",
      "meaning": "GitLab authority retained required proof receipts and release-control readback",
      "releaseControlEffect": "can-support-windows-installed-user-claim-for-exact-candidate"
    },
    {
      "status": "deferred-no-host",
      "meaning": "report is useful but no admitted host exists",
      "releaseControlEffect": "community-signal-only"
    },
    {
      "status": "rejected-insufficient-evidence",
      "meaning": "report cannot be retained as evidence after follow-up",
      "releaseControlEffect": "no-release-control-effect"
    }
  ],
  "triageLoop": [
    {
      "step": "capture-intake",
      "exitCriteria": "report link, reporter handle, installed version, provider, LabVIEW year, bitness, and outcome are recorded"
    },
    {
      "step": "sanitize",
      "exitCriteria": "secrets, proprietary contents, confidential screenshots, private GitLab material, and sensitive paths are removed before retention"
    },
    {
      "step": "verify-completeness",
      "exitCriteria": "required commands, host facts, LabVIEW facts, provider facts, Docker facts when relevant, and reproduction steps are present"
    },
    {
      "step": "classify-execution-surface",
      "exitCriteria": "report is classified as native Windows host LabVIEW, Docker Desktop Windows-container, Docker Desktop Linux-container on Windows, install/PATH, validation-only, compare-execution, documentation, or unsupported request"
    },
    {
      "step": "assign-proof-status",
      "exitCriteria": "proof status ladder value is assigned without treating community reports as admitted proof"
    },
    {
      "step": "decide-candidate-path",
      "exitCriteria": "Windows-proof claim path or community-deferred claim path is selected before reassessment"
    },
    {
      "step": "run-admitted-proof-lanes-if-windows-claim-selected",
      "exitCriteria": "VIHS_WINDOWS_LABVIEW_PROOF_ENABLED is used only on a capable Windows/LabVIEW pipeline and required proof receipts are retained"
    },
    {
      "step": "update-authority-docs",
      "exitCriteria": "release-publication state, RTM, proof-status docs, and exact-release readiness assessment reflect the selected path"
    },
    {
      "step": "reassess-exact-release-readiness",
      "exitCriteria": "selected path, exact release branch, selected exact VSIX, release-branch pipeline, and no-mutation/publication gates are retained"
    }
