{
  "programId": "comparevi",
  "version": 2,
  "description": "Governed local navigation map for the VI History Suite authority repo, its internal and public reader surfaces, its public GitHub source facade, its private GitHub experiment mirror, and the companion repo-standards-review assurance skill repo.",
  "repos": [
    {
      "id": "vi-history-suite",
      "displayName": "VI History Suite",
      "role": "product-authority",
      "expectedRemote": "https://gitlab.com/svelderrainruiz/vi-history-suite.git",
      "localPath": {
        "kind": "current-repo"
      },
      "primaryEntrypoints": [
        "README.md",
        "docs/product/current-state.md",
        "docs/product/SHIP-0001-releasable-vi-history-suite.md",
        "docs/product/wiki-authority-map.md",
        "docs/documentation-workbench.md"
      ]
    },
    {
      "id": "vi-history-suite-source-experiments",
      "displayName": "VI History Suite Source Experiments",
      "role": "experiment-mirror",
      "expectedRemote": "https://github.com/svelderrainruiz/vi-history-suite-source-experiments.git",
      "localPath": {
        "kind": "sibling",
        "relativePath": "../vi-history-suite-source-experiments"
      },
      "primaryEntrypoints": [
        "README.md",
        ".github/workflows/linux-runtime-benchmark-experiment.yml",
        "docker/github-linux-dashboard-benchmark/Dockerfile",
        "docker/github-linux-dashboard-benchmark/run-benchmark.sh"
      ]
    },
    {
      "id": "vi-history-suite.public",
      "displayName": "VI History Suite Public GitHub Source",
      "role": "public-source-facade",
      "expectedRemote": "https://github.com/svelderrainruiz/vi-history-suite.git",
      "localPath": {
        "kind": "sibling",
        "relativePath": "../vi-history-suite.public"
      },
      "primaryEntrypoints": [
        "README.md",
        "INSTALL.md",
        "SUPPORT.md",
        ".devcontainer/devcontainer.json",
        ".github/workflows/public-facade-linux-smoke.yml"
      ]
    },
    {
      "id": "vi-history-suite.wiki",
      "displayName": "VI History Suite Wiki",
      "role": "derived-reader-surface",
      "expectedRemote": "https://gitlab.com/svelderrainruiz/vi-history-suite.wiki.git",
      "localPath": {
        "kind": "sibling",
        "relativePath": "../vi-history-suite.wiki"
      },
      "primaryEntrypoints": [
        "home.md",
        "Install-And-Release.md",
        "User-Workflow.md",
        "Comparison-Reports-And-Dashboard-Review.md",
        "Review-Scenarios-And-Decision-Records.md"
      ]
    },
    {
      "id": "vi-history-suite.github.wiki",
      "displayName": "VI History Suite Public GitHub Wiki",
      "role": "public-user-reader-surface",
      "expectedRemote": "https://github.com/svelderrainruiz/vi-history-suite.wiki.git",
      "localPath": {
        "kind": "sibling",
        "relativePath": "../vi-history-suite.github.wiki"
      },
      "primaryEntrypoints": [
        "Home.md",
        "User-Workflow.md",
        "Install-And-Release.md",
        "Current-State.md",
        "_Sidebar.md"
      ]
    },
    {
      "id": "repo-standards-review",
      "displayName": "repo-standards-review",
      "role": "assurance-skill",
      "expectedRemote": "https://gitlab.com/svelderrainruiz/repo-standards-review.git",
      "localPath": {
        "kind": "codex-skill",
        "skillName": "repo-standards-review"
      },
      "primaryEntrypoints": [
        "README.md",
        "SKILL.md",
        "references/repo-workbench-integration.md",
        "scripts/repo_docs_workbench.py",
        "scripts/repo_jump.py"
      ]
    }
  ]
}
