{
  "name": "vi-history-suite",
  "displayName": "VI History Suite",
  "description": "VS Code extension for content-detected LabVIEW VI history review in Git repositories.",
  "version": "0.2.0",
  "publisher": "svelderrainruiz",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://gitlab.com/svelderrainruiz/vi-history-suite.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "VI History disables background indexing and external LabVIEW comparison-tool execution in untrusted workspaces.",
      "restrictedConfigurations": [
        "viHistorySuite.executionMode",
        "viHistorySuite.labviewCliPath",
        "viHistorySuite.lvComparePath",
        "viHistorySuite.labviewExePath",
        "viHistorySuite.windowsContainerImage",
        "viHistorySuite.preferBitness"
      ]
    }
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onCommand:labviewViHistory.open",
    "onCommand:labviewViHistory.openDocumentation"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "labviewViHistory.open",
        "title": "VI History",
        "category": "VI History"
      },
      {
        "command": "labviewViHistory.openDocumentation",
        "title": "Open Documentation",
        "category": "VI History"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "labviewViHistory.open",
          "group": "3_compare",
          "when": "resourcePath in labviewViHistory.eligiblePaths && isWorkspaceTrusted && gitOpenRepositoryCount >= 1"
        }
      ],
      "editor/title/context": [
        {
          "command": "labviewViHistory.open",
          "group": "3_compare",
          "when": "resourcePath in labviewViHistory.eligiblePaths && isWorkspaceTrusted && gitOpenRepositoryCount >= 1"
        }
      ]
    },
    "configuration": {
      "title": "VI History Suite",
      "properties": {
        "viHistorySuite.strictRsrcHeader": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, require the leading RSRC CRLF bytes in addition to LVIN/LVCC at offset 8."
        },
        "viHistorySuite.maxIndexedConcurrency": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum concurrent eligibility checks during repository indexing."
        },
        "viHistorySuite.historyWindowMode": {
          "type": "string",
          "enum": [
            "auto",
            "capped"
          ],
          "default": "auto",
          "description": "How the VI History panel chooses its retained commit window. Auto loads the full file history when it fits within the automatic safety ceiling; capped uses the explicit maxHistoryEntries limit."
        },
        "viHistorySuite.maxHistoryEntries": {
          "type": "number",
          "default": 100,
          "minimum": 2,
          "maximum": 5000,
          "description": "Explicit retained-commit ceiling when historyWindowMode is capped."
        },
        "viHistorySuite.executionMode": {
          "type": "string",
          "enum": [
            "auto",
            "host-only",
            "docker-only"
          ],
          "default": "auto",
          "description": "Controls whether VI History chooses report-generation runtime providers automatically, stays host-native only, or requires Docker-only execution."
        },
        "viHistorySuite.lvComparePath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit path to LVCompare."
        },
        "viHistorySuite.labviewCliPath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit path to LabVIEWCLI."
        },
        "viHistorySuite.labviewExePath": {
          "type": "string",
          "default": "",
          "description": "Optional explicit path to the preferred LabVIEW executable."
        },
        "viHistorySuite.windowsContainerImage": {
          "type": "string",
          "default": "nationalinstruments/labview:2026q1-windows",
          "description": "Preferred Windows LabVIEW container image for isolated 64-bit comparison-report execution."
        },
        "viHistorySuite.preferBitness": {
          "type": "string",
          "enum": [
            "auto",
            "x86",
            "x64"
          ],
          "default": "auto",
          "description": "Preferred LabVIEW bitness when both x86 and x64 are installed."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf out coverage",
    "compile": "tsc -p .",
    "dev:watch": "tsc -p . --watch --preserveWatchOutput",
    "dev:workspace": "npm run compile && node out/cli/runDevHost.js --prepare-workspace-only",
    "dev:host": "npm run compile && node out/cli/runDevHost.js",
    "program:repos": "npm run compile && node out/cli/runProgramRepoJump.js",
    "wiki:workbench": "npm run compile && node out/cli/runWikiWorkbench.js",
    "wiki:workbench:doctor": "npm run compile && node out/cli/runWikiWorkbench.js doctor",
    "wiki:workbench:discover": "npm run compile && node out/cli/runWikiWorkbench.js discover",
    "wiki:workbench:plan": "npm run compile && node out/cli/runWikiWorkbench.js plan-pages",
    "wiki:workbench:prepare": "npm run compile && node out/cli/runWikiWorkbench.js prepare-publication",
    "wiki:workbench:sync-bundled-docs": "npm run compile && node out/cli/runWikiWorkbench.js sync-bundled-docs",
    "docs:bundle": "node scripts/syncBundledDocs.js",
    "docs:gate": "node scripts/run-docs-gate.js",
    "docs:gate:core": "node scripts/run-docs-gate.js --skip-links",
    "docs:ci": "node scripts/run-docs-continuous-integration.js",
    "docs:ci:core": "node scripts/run-docs-continuous-integration.js --skip-links",
    "dashboard:latest": "node scripts/printLatestDashboardRun.js",
    "dashboard:latest:json": "node scripts/printLatestDashboardRun.js --json",
    "dashboard:latest:host": "node scripts/printLatestDashboardRun.js --host-only",
    "dashboard:latest:host:json": "node scripts/printLatestDashboardRun.js --host-only --json",
    "review:latest": "node scripts/printLatestHumanReviewSubmission.js",
    "review:latest:json": "node scripts/printLatestHumanReviewSubmission.js --json",
    "benchmark:github:linux:canonical": "npm run compile && node out/cli/runGitHubLinuxDashboardBenchmark.js --harness-id HARNESS-VHS-001",
    "benchmark:github:linux:lv-icon": "npm run compile && node out/cli/runGitHubLinuxDashboardBenchmark.js --harness-id HARNESS-VHS-002",
    "benchmark:github:windows:lv-icon": "npm run compile && node out/cli/runGitHubWindowsDashboardBenchmark.js --harness-id HARNESS-VHS-002",
    "benchmark:github:latest": "node scripts/printLatestGitHubLinuxBenchmark.js",
    "benchmark:github:latest:json": "node scripts/printLatestGitHubLinuxBenchmark.js --json",
    "docs:workbench:build": "node scripts/runDocsWorkbenchDocker.js build",
    "docs:workbench:gate": "node scripts/runDocsWorkbenchDocker.js gate",
    "docs:workbench:shell": "node scripts/runDocsWorkbenchDocker.js shell",
    "docs:workbench:gitlab:pull": "node scripts/runDocsWorkbenchDocker.js pull --image-source published",
    "docs:workbench:gitlab:gate": "node scripts/runDocsWorkbenchDocker.js gate --image-source published --pull",
    "docs:workbench:gitlab:shell": "node scripts/runDocsWorkbenchDocker.js shell --image-source published --pull",
    "docs:workbench:wiki:doctor": "node scripts/runDocsWorkbenchDocker.js wiki-doctor",
    "docs:workbench:wiki:plan": "node scripts/runDocsWorkbenchDocker.js wiki-plan",
    "docs:workbench:wiki:prepare": "node scripts/runDocsWorkbenchDocker.js wiki-prepare",
    "docs:workbench:wiki:sync-bundled-docs": "node scripts/runDocsWorkbenchDocker.js wiki-sync-bundled-docs",
    "docs:workbench:gitlab:wiki:doctor": "node scripts/runDocsWorkbenchDocker.js wiki-doctor --image-source published --pull",
    "docs:workbench:gitlab:wiki:plan": "node scripts/runDocsWorkbenchDocker.js wiki-plan --image-source published --pull",
    "docs:workbench:gitlab:wiki:prepare": "node scripts/runDocsWorkbenchDocker.js wiki-prepare --image-source published --pull",
    "docs:workbench:gitlab:wiki:sync-bundled-docs": "node scripts/runDocsWorkbenchDocker.js wiki-sync-bundled-docs --image-source published --pull",
    "check": "tsc -p . --noEmit",
    "design:gate": "npm run compile && node out/cli/runDesignGate.js",
    "design:gate:assert-complete": "npm run compile && node out/cli/runVerifyDesignGateCompletion.js",
    "harness:decision:record": "npm run compile && node out/cli/runHarnessDecisionRecord.js --harness-id HARNESS-VHS-001 --reviewer Codex --review-question \"Does the concentrated evidence support bounded review completion?\" --outcome needs-more-review --confidence medium --decision-rationale \"The dashboard is evidence-rich, but the reviewer should still verify whether more manual inspection is needed.\"",
    "harness:smoke": "npm run compile && node out/cli/runHarnessSmoke.js --harness-id HARNESS-VHS-001",
    "harness:report:smoke": "npm run compile && node out/cli/runHarnessReportSmoke.js --harness-id HARNESS-VHS-001",
    "harness:dashboard:smoke": "npm run compile && node out/cli/runHarnessDashboardSmoke.js --harness-id HARNESS-VHS-001",
    "pretest": "npm run compile",
    "preview:refresh": "npm run package && node -e \"const fs=require('node:fs'); const p=require('./package.json'); const name=p.name+'-'+p.version+'.vsix'; fs.copyFileSync(name, 'preview-evidence/'+name); fs.copyFileSync(name, '/mnt/c/Users/sveld/Downloads/'+name); console.log('Refreshed '+name);\"",
    "test": "vitest run --coverage",
    "test:integration:compile": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile && npm run test:integration:compile && node out-tests/tests/integration/runTests.js",
    "test:integration:linux": "VI_HISTORY_SUITE_INTEGRATION_HOST=linux npm run test:integration",
    "test:integration:windows": "VI_HISTORY_SUITE_INTEGRATION_HOST=windows npm run test:integration",
    "test:watch": "vitest",
    "package:audit": "node scripts/auditPackagedRuntimeSurface.js",
    "package": "npm run compile && npm run docs:bundle && npm run package:audit && node scripts/runPinnedVsce.js package"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.2",
    "@vscode/test-electron": "^2.5.2",
    "marked": "^17.0.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}
