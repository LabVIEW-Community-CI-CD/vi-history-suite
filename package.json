{
  "name": "vi-history-suite",
  "displayName": "VI History Suite",
  "description": "VS Code extension for content-detected LabVIEW VI history review in Git repositories.",
  "version": "1.3.12",
  "publisher": "svelderrainruiz",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/svelderrainruiz/vi-history-suite.git"
  },
  "homepage": "https://github.com/svelderrainruiz/vi-history-suite/wiki",
  "bugs": {
    "url": "https://github.com/svelderrainruiz/vi-history-suite/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "VI History disables background indexing and installed comparison execution in untrusted workspaces.",
      "restrictedConfigurations": [
        "viHistorySuite.runtimeProvider",
        "viHistorySuite.labviewVersion",
        "viHistorySuite.labviewBitness"
      ]
    }
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "icon": "resources/marketplace/vi-history-suite-icon.png",
  "main": "./out/extension.js",
  "files": [
    "out/**",
    "node_modules/jsonc-parser/**",
    "resources/**",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:labviewViHistory.open",
    "onCommand:labviewViHistory.prepareLocalRuntimeSettingsCli",
    "onCommand:labviewViHistory.openDocumentation"
  ],
  "extensionDependencies": [
    "vscode.git"
  ],
  "contributes": {
    "commands": [
      {
        "command": "labviewViHistory.open",
        "title": "VI History",
        "category": "VI History"
      },
      {
        "command": "labviewViHistory.openDocumentation",
        "title": "Open Documentation",
        "category": "VI History"
      },
      {
        "command": "labviewViHistory.prepareLocalRuntimeSettingsCli",
        "title": "Prepare Local Runtime Settings CLI",
        "category": "VI History"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "labviewViHistory.open",
          "group": "3_compare",
          "when": "(resourceExtname == .vi || resourceExtname == .ctl || resourceExtname == .vit) && isWorkspaceTrusted"
        }
      ],
      "editor/title/context": [
        {
          "command": "labviewViHistory.open",
          "group": "3_compare",
          "when": "(resourceExtname == .vi || resourceExtname == .ctl || resourceExtname == .vit) && isWorkspaceTrusted"
        }
      ]
    },
    "configuration": {
      "title": "VI History Suite",
      "properties": {
        "viHistorySuite.strictRsrcHeader": {
          "type": "boolean",
          "default": false,
          "description": "When enabled, require the leading RSRC CRLF bytes in addition to LVIN/LVCC at offset 8."
        },
        "viHistorySuite.maxIndexedConcurrency": {
          "type": "number",
          "default": 6,
          "minimum": 1,
          "maximum": 16,
          "description": "Maximum concurrent eligibility checks during repository indexing."
        },
        "viHistorySuite.historyWindowMode": {
          "type": "string",
          "enum": [
            "auto",
            "capped"
          ],
          "default": "auto",
          "description": "How the VI History panel chooses its retained commit window. Auto loads the full file history when it fits within the automatic safety ceiling; capped uses the explicit maxHistoryEntries limit."
        },
        "viHistorySuite.maxHistoryEntries": {
          "type": "number",
          "default": 100,
          "minimum": 2,
          "maximum": 5000,
          "description": "Explicit retained-commit ceiling when historyWindowMode is capped."
        },
        "viHistorySuite.runtimeProvider": {
          "type": "string",
          "enum": [
            "host",
            "docker"
          ],
          "description": "Installed-user compare provider request. Host is the default local LabVIEWCLI path; docker is a bounded expert path selected through the generated settings CLI."
        },
        "viHistorySuite.labviewVersion": {
          "type": "string",
          "description": "Required installed-user LabVIEW major version for comparison preflight. Example: 2026."
        },
        "viHistorySuite.labviewBitness": {
          "type": "string",
          "enum": [
            "x86",
            "x64"
          ],
          "description": "Required installed-user LabVIEW bitness for comparison preflight."
        }
      }
    }
  },
  "scripts": {
    "clean": "rimraf out coverage",
    "compile": "tsc -p .",
    "dev:watch": "tsc -p . --watch --preserveWatchOutput",
    "dev:workspace": "npm run compile && node out/cli/runDevHost.js --prepare-workspace-only",
    "dev:host": "npm run compile && node out/cli/runDevHost.js",
    "program:repos": "npm run compile && node out/cli/runProgramRepoJump.js",
    "wiki:workbench": "npm run compile && node out/cli/runWikiWorkbench.js",
    "wiki:workbench:doctor": "npm run compile && node out/cli/runWikiWorkbench.js doctor",
    "wiki:workbench:discover": "npm run compile && node out/cli/runWikiWorkbench.js discover",
    "wiki:workbench:plan": "npm run compile && node out/cli/runWikiWorkbench.js plan-pages",
    "wiki:workbench:prepare": "npm run compile && node out/cli/runWikiWorkbench.js prepare-publication",
    "wiki:workbench:sync-bundled-docs": "npm run compile && node out/cli/runWikiWorkbench.js sync-bundled-docs",
    "docs:bundle": "node scripts/syncBundledDocs.js",
    "docs:gate": "node scripts/run-docs-gate.js",
    "docs:gate:core": "node scripts/run-docs-gate.js --skip-links",
    "docs:ci": "node scripts/run-docs-continuous-integration.js",
    "docs:ci:core": "node scripts/run-docs-continuous-integration.js --skip-links",
    "docs:ci:public": "node scripts/run-docs-continuous-integration.js --surface public",
    "docs:ci:public:core": "node scripts/run-docs-continuous-integration.js --surface public --skip-links",
    "docs:ci:internal": "node scripts/run-docs-continuous-integration.js --surface internal",
    "docs:ci:internal:core": "node scripts/run-docs-continuous-integration.js --surface internal --skip-links",
    "assurance:release-gate": "node scripts/runAssuranceAudit.js --lane release-gate",
    "assurance:26514:authority": "node scripts/runAssuranceAudit.js --lane 26514-authority",
    "assurance:requirements": "node scripts/runAssuranceAudit.js --lane requirements",
    "assurance:user-info": "node scripts/runAssuranceAudit.js --lane user-info",
    "assurance:evidence-pack": "node scripts/runAssuranceAudit.js --lane evidence-pack",
    "assurance:uplift": "node scripts/runAssuranceAudit.js --lane uplift",
    "gitlab:git-credential:refresh": "node scripts/refreshLocalGitLabGitCredential.js",
    "gitlab:private-release:publish": "node scripts/publishWindowsPrivateRelease.js",
    "gitlab:runner:assert": "scripts\\invoke-node-from-npm-execpath.cmd scripts/assertGovernedRunnerLanes.js",
    "gitlab:runner:doctor": "scripts\\invoke-node-from-npm-execpath.cmd scripts/doctorGovernedRunnerLanes.js",
    "gitlab:runner:windows:recovery:rehearse": "npm run compile && scripts\\invoke-node-from-npm-execpath.cmd scripts/runWindowsProofRuntimeRecoveryRehearsal.js",
    "branch:governance:assert": "node scripts/assertGovernedBranchBaseline.js",
    "linux:docker:provider:lane": "npm run compile && node scripts/runLinuxDockerProviderLane.js",
    "public:host:bootstrap-linux": "node scripts/bootstrapLinuxVsCodeHost.js install",
    "public:smoke:linux": "npm run compile && node scripts/runPublicLinuxInstalledUserSmoke.js",
    "public:contract:windows-installed-user": "node scripts/runPublicWindowsInstalledUserContract.js",
    "public:repo:clone": "node scripts/preparePublicRepoClone.js",
    "public:fixture:icon-editor": "node scripts/preparePublicTestFixture.js",
    "public:gate-d:preflight": "node scripts/runPublicProductGateDPreflight.js",
    "public:gate-d:prepare-cold-pull": "node scripts/runPublicProductGateDPreflight.js --prepare-cold-pull",
    "public:source:promote": "node scripts/promotePublicGithubSource.js",
    "public:source:check": "node scripts/promotePublicGithubSource.js --check",
    "public:exact:pretag:proof": "node scripts/runPublicExactPretagProof.js",
    "public:github:exact:transaction:assess": "node scripts/runPublicGithubExactReleaseTransaction.js --mode assess",
    "public:github:exact:transaction:publish": "node scripts/runPublicGithubExactReleaseTransaction.js --mode publish",
    "public:github:exact:transaction:verify": "node scripts/runPublicGithubExactReleaseTransaction.js --mode verify",
    "vscode:marketplace:install-proof": "node scripts/runWindowsExactVsixInstallProof.js",
    "vscode:marketplace:prepare": "node scripts/prepareVsCodeMarketplacePublication.js",
    "vscode:marketplace:community-preview:prepare": "node scripts/prepareMarketplaceCommunityValidationPreview.js",
    "software:factory:assess": "node scripts/runSoftwareFactoryOrchestrator.js --phase assess",
    "software:factory:rehearse": "node scripts/runSoftwareFactoryOrchestrator.js --phase rehearse",
    "software:factory:repair": "node scripts/runSoftwareFactoryOrchestrator.js --phase repair",
    "software:factory:publish": "node scripts/runSoftwareFactoryOrchestrator.js --phase publish",
    "software:factory:verify": "node scripts/runSoftwareFactoryOrchestrator.js --phase verify",
    "dashboard:latest": "node scripts/printLatestDashboardRun.js",
    "dashboard:latest:json": "node scripts/printLatestDashboardRun.js --json",
    "dashboard:latest:host": "node scripts/printLatestDashboardRun.js --host-only",
    "dashboard:latest:host:json": "node scripts/printLatestDashboardRun.js --host-only --json",
    "review:latest": "node scripts/printLatestHumanReviewSubmission.js",
    "review:latest:json": "node scripts/printLatestHumanReviewSubmission.js --json",
    "benchmark:github:latest": "node scripts/printLatestGitHubLinuxBenchmark.js",
    "benchmark:github:latest:json": "node scripts/printLatestGitHubLinuxBenchmark.js --json",
    "docs:workbench:build": "node scripts/runDocsWorkbenchDocker.js build",
    "docs:workbench:gate": "node scripts/runDocsWorkbenchDocker.js gate",
    "docs:workbench:shell": "node scripts/runDocsWorkbenchDocker.js shell",
    "docs:workbench:gitlab:pull": "node scripts/runDocsWorkbenchDocker.js pull --image-source published",
    "docs:workbench:gitlab:gate": "node scripts/runDocsWorkbenchDocker.js gate --image-source published --pull",
    "docs:workbench:gitlab:shell": "node scripts/runDocsWorkbenchDocker.js shell --image-source published --pull",
    "docs:workbench:wiki:doctor": "node scripts/runDocsWorkbenchDocker.js wiki-doctor",
    "docs:workbench:wiki:plan": "node scripts/runDocsWorkbenchDocker.js wiki-plan",
    "docs:workbench:wiki:prepare": "node scripts/runDocsWorkbenchDocker.js wiki-prepare",
    "docs:workbench:wiki:sync-bundled-docs": "node scripts/runDocsWorkbenchDocker.js wiki-sync-bundled-docs",
    "docs:workbench:gitlab:wiki:doctor": "node scripts/runDocsWorkbenchDocker.js wiki-doctor --image-source published --pull",
    "docs:workbench:gitlab:wiki:plan": "node scripts/runDocsWorkbenchDocker.js wiki-plan --image-source published --pull",
    "docs:workbench:gitlab:wiki:prepare": "node scripts/runDocsWorkbenchDocker.js wiki-prepare --image-source published --pull",
    "docs:workbench:gitlab:wiki:sync-bundled-docs": "node scripts/runDocsWorkbenchDocker.js wiki-sync-bundled-docs --image-source published --pull",
    "check": "tsc -p . --noEmit",
    "design:gate": "npm run compile && node out/cli/runDesignGate.js",
    "design:gate:assert-complete": "npm run compile && node out/cli/runVerifyDesignGateCompletion.js",
    "proof:run": "npm run compile && node out/cli/runGovernedProof.js",
    "proof:runtime-settings-live-session": "node scripts/runRuntimeSettingsLiveSessionProof.js",
    "acceptance:windows:private-release": "scripts\\invoke-node-from-npm-execpath.cmd .\\node_modules\\typescript\\bin\\tsc -p . && scripts\\invoke-node-from-npm-execpath.cmd scripts/runWindowsPrivateReleaseAcceptance.js",
    "proof:runtime-settings-live-session:assert": "node scripts/assertRuntimeSettingsLiveSessionProbePacket.js",
    "proof:runtime-settings-live-session:history": "node scripts/printRuntimeSettingsLiveSessionProbeHistory.js",
    "proof:runtime-settings-live-session:policy:assert": "node scripts/assertRuntimeSettingsLiveSessionPolicyBoundary.js",
    "test:design-contract": "npm exec -- vitest run tests/unit/packageManifest.test.ts tests/unit/comparisonRuntimeLocator.test.ts tests/unit/runGovernedProofCli.test.ts tests/unit/governedLegacyProofEntrypoints.test.ts tests/unit/governedProofDocs.test.ts tests/unit/githubLinuxBenchmarkWorkflow.test.ts tests/unit/githubWindowsBenchmarkWorkflow.test.ts tests/unit/designGate.test.ts tests/unit/designGateRunner.test.ts tests/unit/preparePublicRepoCloneScript.test.ts tests/unit/preparePublicTestFixtureScript.test.ts tests/unit/publicDevcontainerSurface.test.ts tests/unit/publicExactPretagProof.test.ts tests/unit/publicLinuxInstalledUserSmoke.test.ts tests/unit/publicWindowsInstalledUserContract.test.ts tests/unit/publicGithubExactReleaseTransaction.test.ts tests/unit/publicGithubSourcePromotion.test.ts tests/unit/publicProductGateDPreflight.test.ts tests/unit/resolveLocalGitHubToken.test.ts tests/unit/softwareFactoryOrchestrator.test.ts tests/unit/runWindowsIntegrationHost.test.ts tests/unit/linuxHostLabviewProofDocs.test.ts",
    "pretest": "npm run compile",
    "preview:refresh": "npm run package && node -e \"const fs=require('node:fs'); const p=require('./package.json'); const name=p.name+'-'+p.version+'.vsix'; fs.copyFileSync(name, 'preview-evidence/'+name); fs.copyFileSync(name, '/mnt/c/Users/sveld/Downloads/'+name); console.log('Refreshed '+name);\"",
    "test": "vitest run --coverage",
    "test:integration:compile": "tsc -p tsconfig.integration.json",
    "test:integration": "npm run compile && npm run test:integration:compile && node out-tests/tests/integration/runTests.js",
    "test:integration:linux": "node scripts/runLinuxIntegrationHost.js",
    "test:integration:windows": "node scripts/runWindowsIntegrationHost.js",
    "test:watch": "vitest",
    "package:audit": "node scripts/auditPackagedRuntimeSurface.js",
    "package": "npm run compile && npm run docs:bundle && npm run package:audit && node scripts/runPinnedVsce.js package"
  },
  "devDependencies": {
    "@types/node": "^24.6.0",
    "@types/vscode": "^1.90.0",
    "@vitest/coverage-v8": "^4.1.4",
    "@vscode/test-electron": "^2.5.2",
    "marked": "^17.0.5",
    "rimraf": "^6.0.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  }
}
