#!/usr/bin/env bash
#
# vi-history-suite pre-commit hook (VHS-REQ-697).
#
# This is the ENFORCING gate. git honors this hook's exit code, so a nonzero exit
# aborts the commit. It fails closed ONLY on a hard-stale condition (node_modules
# out of sync with package-lock.json), which genuinely breaks tsc/vitest — a
# doc-only commit with merely a stale out/ is NOT blocked (out/ staleness is
# advisory in checkEnvSync).
#
# Honest limitation: `git commit --no-verify` bypasses all client-side hooks; git
# provides no way to prevent that at the hook level. Per repository policy
# (AGENTS.md) agents MUST NOT use --no-verify as a shortcut.
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$repo_root" || exit 0

if ! node scripts/checkEnvSync.js --enforce --label pre-commit; then
  echo "[pre-commit] Blocking: your local environment is out of sync. Run the remedy above (e.g. 'npm ci'), then commit again." >&2
  exit 1
fi

# Container-diagnostics enforcement (VHS-REQ-710 / ADR-0029). This ENFORCES — not
# advises — that the NI LabVIEW container is set up to run a real comparison. A
# non-ready container (missing Docker/daemon/image/LabVIEWCLI/engine/lvcompare)
# blocks the commit. Set VIHS_PRECOMMIT_SKIP_DIAGNOSTICS=1 ONLY for an environment
# that legitimately has no Docker (this skips one gate, not all hooks — it is not
# --no-verify). Quiet on success; the full check list prints only on failure.
if [ "${VIHS_PRECOMMIT_SKIP_DIAGNOSTICS:-0}" != "1" ]; then
  # The diagnostics engine is compiled under out/ (built by `npm run compile`).
  # On a fresh checkout it may be absent; consistent with out/ staleness being
  # advisory (not blocking) in checkEnvSync, skip the container-readiness gate
  # rather than block an otherwise-valid (e.g. doc-only) commit. Compiling
  # re-enables enforcement.
  if [ ! -f out/reporting/containerDiagnostics/labviewContainerDiagnostics.js ]; then
    echo "[pre-commit] advisory: compiled diagnostics engine absent (out/ not built); skipping container-readiness gate. Run 'npm run compile' to enable it." >&2
  else
    diagnostics_output="$(node scripts/diagnoseLabviewContainer.js 2>&1)"
    if [ "$?" -ne 0 ]; then
      printf '%s\n' "$diagnostics_output" >&2
      echo "[pre-commit] Blocking: the NI LabVIEW container is not ready to compare (VHS-REQ-710). Apply the reported 'next' remediation, or set VIHS_PRECOMMIT_SKIP_DIAGNOSTICS=1 if this host has no Docker." >&2
      exit 1
    fi
  fi
fi

exit 0
