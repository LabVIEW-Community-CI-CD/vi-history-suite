#!/usr/bin/env bash
#
# vi-history-suite pre-push gate.
#
# Fails closed before a push on:
#   1. Branch-flow enforcement (issue #2392) — scripts/branchFlowEnforce.js (runs FIRST:
#      cheapest + most common papercut; Branch-Governance parity).
#   2. ADR infrastructure consistency (issue #2028) — npm run adr:check.
#   3. Agent-delegation drift — npm run agent:check.
#   4. The repo-standards-review multi-standards audit — npm run standards:audit.
#
# Enable once per clone with:  git config core.hooksPath .githooks
# Bypass in an emergency with:  git push --no-verify
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# 0. Agent gateway (issue #2392, VHS-REQ-719): serialize the resource-heavy validation
#    phase (adr/agent/standards) across concurrent agents/subagents on this machine so
#    N heavy runs do not thrash CPU/GPU at once. Enforced (waits) only in a MULTI-AGENT
#    context (VIHS_SUBAGENT_ID set or >1 git worktree); advisory + zero-friction for a
#    solo push; a bounded retry DEGRADES TO ADVISORY (warn + proceed) on timeout — it
#    NEVER hard-blocks the push. Contended retries are recorded to a contention ledger
#    (timestamp + CPU/GPU snapshot) for benchmark correlation. Released on any exit.
node scripts/prePushGate.js acquire || true
trap 'node scripts/prePushGate.js release >/dev/null 2>&1 || true' EXIT

# 1. Branch-flow enforcement (issue #2392) runs FIRST. git passes the push refs on
#    stdin (<local ref> <local sha> <remote ref> <remote sha> lines); forward them to
#    the pure evaluator, which fails closed with a clear remedy. Rule C (issue exists)
#    self-skips with an audit note when gh is unavailable on this plane.
push_refs="$(cat)"
echo "[pre-push] Checking branch flow (scripts/branchFlowEnforce.js)…"
if ! printf '%s' "$push_refs" | node scripts/branchFlowEnforce.js; then
  echo "[pre-push] Branch-flow enforcement failed. See the remedy above, or push with --no-verify." >&2
  exit 1
fi

echo "[pre-push] Checking ADR infrastructure (npm run adr:check)…"
if ! npm run --silent adr:check; then
  echo "[pre-push] ADR infrastructure check failed. Fix docs/architecture/adr/ or run with --no-verify." >&2
  exit 1
fi

echo "[pre-push] Checking agent-delegation drift (npm run agent:check)…"
if ! npm run --silent agent:check; then
  echo "[pre-push] Agent-delegation drift detected. Align issue-template dropdowns with .github/agents/, or run with --no-verify." >&2
  exit 1
fi

echo "[pre-push] Running repo-standards-review audit (npm run standards:audit)…"
if ! npm run --silent standards:audit >/dev/null; then
  echo "[pre-push] repo-standards-review audit failed. Run 'npm run standards:audit' for detail, or push with --no-verify." >&2
  exit 1
fi

echo "[pre-push] Pre-push gates passed."
